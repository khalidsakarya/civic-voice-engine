{
  "name": "civic-voice-engine",
  "version": "1.0.0",
  "description": "Universal government data ingestion and AI processing engine for Civic Voice",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "ingest": "node src/ingest.js",
    "process:bills": "node src/processBills.js",
    "score:efficiency": "node src/scoreEfficiency.js",
    "upload:firebase": "node src/uploadToFirebase.js",
    "scheduler": "node src/scheduler.js",
    "scheduler:now": "node src/scheduler.js --now",
    "scheduler:daily": "node src/scheduler.js --daily",
    "scheduler:weekly": "node src/scheduler.js --weekly",
    "scheduler:bimonthly": "node src/scheduler.js --bimonthly",
    "scheduler:monthly": "node src/scheduler.js --monthly",
    "scheduler:dryrun": "node src/dryRun.js",
    "ingest:expenses": "node src/ingestion/expenseFetcher.js",
    "process:expenses": "node src/processing/expenseProcessor.js",
    "detect:waste": "node src/processing/wasteDetector.js",
    "upload:expenses": "node src/firebase/uploadExpenses.js",
    "scheduler:expenses": "node src/scheduler.js --expenses",
    "ingest:leaders": "node src/ingestion/leaderExpenseFetcher.js",
    "process:leaders": "node src/processing/leaderExpenseProcessor.js",
    "upload:leaders": "node src/firebase/uploadLeaderExpenses.js",
    "pipeline:leaders": "npm run ingest:leaders && npm run process:leaders && npm run upload:leaders",
    "detect:anomalies": "node src/processing/leaderAnomalyDetector.js",
    "upload:anomalies": "node src/firebase/uploadExpenseAnomalies.js",
    "build:leaderboard": "node src/processing/leaderLeaderboard.js",
    "upload:leaderboard": "node -e \"require('dotenv').config(); const {uploadLeaderboard}=require('./src/firebase/uploader'); uploadLeaderboard().then(n=>{ console.log('[upload:leaderboard] Done —',n,'docs'); process.exit(0); }).catch(e=>{ console.error(e.message); process.exit(1); })\"",
    "scheduler:leader-expenses": "node src/scheduler.js --leader-expenses",
    "scheduler:budget-analytics": "node src/scheduler.js --budget-analytics",
    "ingest:budget-analytics": "node src/ingestion/budgetAnalyticsFetcher.js",
    "scheduler:gov-stats": "node src/scheduler.js --gov-stats",
    "ingest:gov-stats": "node src/ingestion/govStatsFetcher.js",
    "ingest:social-stats": "node src/ingestion/socialStatsFetcher.js",
    "upload:social-stats": "node -e \"require('dotenv').config(); const {uploadSocialStats}=require('./src/firebase/uploader'); uploadSocialStats().then(n=>{ console.log('[upload:social-stats] Done —',n,'docs'); process.exit(0); }).catch(e=>{ console.error(e.message); process.exit(1); })\"",
    "pipeline:social-stats": "npm run ingest:social-stats && npm run upload:social-stats",
    "process:gov-stats": "node src/processing/govStatsProcessor.js",
    "audit:apis": "node src/audit/govApiAudit.js",
    "live:fetch": "node src/ingestion/liveFetch.js",
    "upload:live-stats": "node src/firebase/uploadLiveStats.js",
    "upload:social-stats": "node src/firebase/uploadSocialStatsCanonical.js",
    "pipeline:live-stats": "npm run live:fetch && npm run upload:social-stats",
    "fetch:targeted": "node src/ingestion/targetedFetch.js",
    "pipeline:full": "npm run start && npm run process:bills && npm run score:efficiency && npm run upload:firebase",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "civic",
    "government",
    "ai",
    "data-ingestion"
  ],
  "author": "khalidsakarya",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.7.0",
    "node-cron": "^4.2.1"
  }
}
