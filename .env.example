# =============================================================
# Civic Voice Engine — Environment Variables
# =============================================================

# -----------------------------------------------
# Claude AI (REQUIRED)
# Sign up: https://console.anthropic.com
# -----------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================
# GOVERNMENT APIs — REQUIRES SIGNUP (free)
# =============================================================

# USA — Congress.gov
# Sign up: https://api.congress.gov/sign-up (free, email-based)
CONGRESS_API_KEY=your_congress_api_key_here

# USA — OpenStates (state legislatures)
# Sign up: https://openstates.org/accounts/login (free tier available)
OPENSTATES_API_KEY=your_openstates_api_key_here

# UK — TheyWorkForYou
# Sign up: https://www.theyworkforyou.com/api/ (paid from £20/mo; free for nonprofits)
THEYWORKFORYOU_API_KEY=your_theyworkforyou_api_key_here

# =============================================================
# FIREBASE (REQUIRED for upload:firebase and scheduler)
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate new private key (downloads a JSON file)
# Then copy the fields below from that JSON file.
# =============================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Alternative: point to the downloaded service account JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Optional: override cron schedule (default: 2am daily)
# CRON_SCHEDULE=0 2 * * *

# =============================================================
# GOVERNMENT APIs — NO SIGNUP REQUIRED (completely free)
# =============================================================
# The following APIs require no key — they are configured in
# config/sources.json and used automatically:
#
#  Canada  — OpenParliament.ca       https://api.openparliament.ca
#  Canada  — Open Government Portal  https://open.canada.ca/data/api/action
#  UK      — UK Parliament Bills API https://bills-api.parliament.uk/api/v1
#  UK      — UK Parliament Members   https://members-api.parliament.uk/api
#
# Note: Australia APH API (https://www.aph.gov.au/api) returns 404 —
# no public REST API is currently available from APH.
# =============================================================
